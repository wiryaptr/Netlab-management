# NetLab Manager — Environment Variables Example
# Salin ke .env dan isi dengan secret produksi

DJANGO_SECRET_KEY=insecure-default-change-me-in-production-1234567890
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
TIME_ZONE=Asia/Jakarta

# Database Credentials
# Runtime (digunakan oleh aplikasi backend saat jalan)
DATABASE_URL=postgres://netlab_app:change_me_app_password@db:5432/netlab

# Migration (hanya untuk job migrasi skema dan backup/restore)
DATABASE_MIGRATION_URL=postgres://netlab_owner:change_me_owner_password@db:5432/netlab
